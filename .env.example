# Backend de Pixie. Configure los valores reales solo en las variables del entorno de Netlify.
GEMINI_API_KEY=
MAKE_PIXIE_WEBHOOK_URL=
MAKE_PIXIE_API_KEY=

# Alias opcional para el flujo consolidado. Si no se define, se usa el par MAKE_PIXIE_*.
# URL y API key siempre deben configurarse como un mismo par.
MAKE_SITE_INTAKE_WEBHOOK_URL=
MAKE_SITE_INTAKE_API_KEY=

# Compatibilidad temporal con el nombre anterior. No es necesario si se usa MAKE_PIXIE_WEBHOOK_URL.
MAKE_WEBHOOK_URL=

PIXIE_LEAD_THRESHOLD=30
PIXIE_WEBHOOK_ENABLED=true
PIXIE_WEBHOOK_DEBOUNCE_MINUTES=10
PIXIE_WEBHOOK_TIMEOUT_MS=5000
PIXIE_STATE_SECRET=

# Solo para Netlify Dev. El backend ignora el payload de depuración en producción.
PIXIE_DEBUG_PAYLOAD=false
